# Supabase project credentials (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key - server-only, NEVER expose to the client or prefix with NEXT_PUBLIC_
# Used only by the deadline-reminder cron worker (src/lib/supabase/admin.ts),
# which has no logged-in user session and must bypass RLS to read reminders
# and look up recipient emails across all users.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of the deployed app, used for OG/canonical metadata and email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (resend.com) API key - powers deadline reminder emails.
# Leave blank to disable sending; reminders still get scheduled in the
# database either way (see EMAIL_FROM below).
RESEND_API_KEY=

# Verified sender identity, e.g. "LaunchPoint <notifications@yourdomain.com>".
# Defaults to Resend's shared test address if left blank.
EMAIL_FROM=

# Shared secret the cron trigger must send as `Authorization: Bearer <secret>`.
# Generate one with `openssl rand -hex 32`.
CRON_SECRET=
